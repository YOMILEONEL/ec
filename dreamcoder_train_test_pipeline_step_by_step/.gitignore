# DreamCoder's own auto-exported checkpoint pickles. These encode every run
# parameter into the filename (e.g. "..._aic=1.0_..._topkNotMAP=False_rec=False.pickle"),
# which exceeds Windows' default 260-character path limit once nested under
# outputs/<run_key>/step04_run_dreamcoder/. They are also redundant with our
# own step04_dreamcoder_train_test_result.pkl, which has a normal-length name.
outputs/**/dreamcoder_train_test_aic=*.pickle

# Jupyter autosave duplicate of the notebook, not useful to version.
.ipynb_checkpoints/

# Input dataset (copied/generated, not authored here) and all run outputs
# (fully regenerated by run_all.sh / the notebook - hundreds of MB across
# many experimental runs, including failed/exploratory ones). Neither
# belongs in version control.
dataset/
outputs/

# Scratch memory-monitoring script + logs from ad-hoc debugging sessions
# (e.g. tracking down the recognition+consolidation WSL2 OOM crash) - not
# part of the pipeline itself, disposable.
diag/
