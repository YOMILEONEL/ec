# DreamCoder's own auto-exported checkpoint pickles. These encode every run
# parameter into the filename (e.g. "..._aic=1.0_..._topkNotMAP=False_rec=False.pickle"),
# which exceeds Windows' default 260-character path limit once nested under
# outputs/<run_key>/step04_run_dreamcoder/. They are also redundant with our
# own step04_dreamcoder_train_test_result.pkl, which has a normal-length name.
outputs/**/dreamcoder_train_test_aic=*.pickle

# Jupyter autosave duplicate of the notebook, not useful to version.
.ipynb_checkpoints/

# Input dataset (copied/generated, not authored here) - fully regenerable,
# does not belong in version control.
dataset/

# Run outputs are regenerated by run_all.sh / the notebook and can add up to
# hundreds of MB across many experimental runs. Most of these (including
# failed/exploratory ones) are excluded, but the three controlled 500-task/
# 3-iteration runs actually cited in the thesis (Consolidation, Recognition,
# combined) are tracked for reproducibility.
outputs/*
!outputs/train_T_2_train__test_T_2_test__ET_15_TT_15_it_3_MF_10_rec_false_nocons_false/
!outputs/train_T_2_train__test_T_2_test__ET_15_TT_15_it_3_MF_10_rec_true_nocons_true/
!outputs/train_T_2_train__test_T_2_test__ET_15_TT_15_it_3_MF_10_rec_true_nocons_false/

# Scratch memory-monitoring script + logs from ad-hoc debugging sessions
# (e.g. tracking down the recognition+consolidation WSL2 OOM crash) - not
# part of the pipeline itself, disposable.
diag/
